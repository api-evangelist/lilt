{
  "opencollection": "1.0.0",
  "info": {
    "name": "LILT Create Languages API",
    "version": "v3.0.3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Languages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve supported languages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lilt.com/v2/languages"
          },
          "docs": "Get a list of supported languages.\n\n"
        }
      ]
    }
  ],
  "bundled": true
}