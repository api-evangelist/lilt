        {
          "id": "a321bdb8-99f2-456c-9412-e6805073c328",
          "name": "Pretranslate Documents",
          "request": {
            "name": "Pretranslate Documents",
            "description": {
              "content": "Pretranslate one or more Documents using translation memory (TM) and,\noptionally, machine translation (MT). Only documents that are not\ncurrently importing/exporting and are not already pretranslating will\nbe pretranslated; the response always reflects the current state of\nevery requested Document id, whether or not it was eligible.\n\nThis is an asynchronous operation. The endpoint returns immediately\nwith a `202` response once pretranslation has been queued; poll the\nDocument resource (or the `is_pretranslating` / `status.pretranslation`\nfields it returns) to see when pretranslation has finished.\n\nThis endpoint is subject to a per-organization rate limit. See the\n[API Rate Limits guide](/developers/guides/rate-limits) for details on\nhow to read `429` responses and batch requests efficiently by passing\nmultiple document ids in a single call.\n\nExample CURL:\n```bash\ncurl -X POST 'https://api.lilt.com/v2/documents/pretranslate?key=API_KEY' \\\n--header 'Content-Type: application/json' \\\n--data-raw '{\"id\": [274, 275], \"mode\": \"TM+MT\", \"auto_accept\": true}'\n```\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "documents",
                "pretranslate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "auto_accept",
                  "value": "<boolean>",
                  "description": "Auto-accept segments with 100% translation memory matches. Can also be passed in the request body. Defaults to your organization's `Accept and lock exact matches` setting."
                },
                {
                  "disabled": false,
                  "key": "case_sensitive",
                  "value": "<boolean>",
                  "description": "Use case-sensitive translation memory matching. Can also be passed in the request body. Defaults to your organization's `Use case sensitive translation memory matching` setting."
                },
                {
                  "disabled": false,
                  "key": "attribute_to_creator",
                  "value": "<boolean>",
                  "description": "Attribute translation authorship of exact matches to the author of the document. Can also be passed in the request body. Defaults to your organization's `Translation authorship` setting."
                },
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "TM",
                  "description": "Pretranslation mode. Can also be passed in the request body. Defaults to `TM`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<integer>\",\n  \"mode\": \"TM\",\n  \"auto_accept\": \"<boolean>\",\n  \"case_sensitive\": \"<boolean>\",\n  \"attribute_to_creator\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
