        {
          "id": "d9def366-f659-45c0-b7bb-2d7f927b837b",
          "name": "Upload a File",
          "request": {
            "name": "Upload a File",
            "description": {
              "content": "Create a Document from a file in any of the formats [documented in our knowledge base](/kb/supported-file-formats).\nRequest parameters should be passed as JSON object with the header field `LILT-API`.\n\nFile names in the header can only contain [US-ASCII characters](https://en.wikipedia.org/wiki/ASCII). File names with characters outside of US-ASCII should be [URI encoded](https://en.wikipedia.org/wiki/Percent-encoding) or transliterated to US-ASCII strings.\n\nExample CURL command:\n```bash\n  curl -X POST https://api.lilt.com/v2/documents/files?key=API_KEY \\\n  --header \"LILT-API: {\\\"name\\\": \\\"introduction.xliff\\\",\\\"pretranslate\\\": \\\"tm+mt\\\",\\\"project_id\\\": 9}\" \\\n  --header \"Content-Type: application/octet-stream\" \\\n  --data-binary @Introduction.xliff\n```\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "documents",
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) A file name.",
                "key": "name",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) A unique Project identifier.",
                "key": "project_id",
                "value": "<integer>"
              },
              {
                "disabled": false,
                "description": "An optional parameter indicating if and how the document will be\npretranslated upon being uploaded.\nThe accepted values are `TM`, or `TM+MT`\n",
                "key": "pretranslate",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "An optional parameter to auto-accept segments with 100% translation\nmemory matches when the `pretranslate` option is also set, or to\nauto-accept any target data that is present when the uploaded file\nis XLIFF. If omitted it will default to your organization settings for `Accept and lock exact matches`,\nif set to `false`, no segments will be auto-accepted.\n",
                "key": "auto_accept",
                "value": "<boolean>"
              },
              {
                "disabled": false,
                "description": "An optional parameter to use case sensitive translation memory matching when the `pretranslate`\noption is also enabled. Matches must have identical character-by-character case to qualify as matches.\nDefault value matches your organization settings for `Use case sensitive translation memory matching` setting\n",
                "key": "case_sensitive",
                "value": "<boolean>"
              },
              {
                "disabled": false,
                "description": "An optional parameter to attribute translation authorship of exact matches to the author of the file\nwhen the `pretranslate` option is also enabled. Default value matches your organization settings for `Translation authorship` setting\n",
                "key": "match_attribution",
                "value": "<boolean>"
              },
              {
                "disabled": false,
                "description": "An optional pararameter to specify an import configuration to\nbe applied when extracting translatable content from this file.\n",
                "key": "config_id",
                "value": "<integer>"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "file"
            }
          },
          "response": [
