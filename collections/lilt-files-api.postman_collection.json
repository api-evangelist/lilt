        {
          "id": "f880ded8-47f5-4b81-9fd3-cbcd5bbaa9f4",
          "name": "Retrieve a File",
          "request": {
            "name": "Retrieve a File",
            "description": {
              "content": "Retrieves one or more files available to your user. Files are not associated with a project or a memory. They are unprocessed and can be used later in the project/document creation workflow step.\n\nTo retrieve a specific file, specify the <strong>id</strong> request parameter. To retrieve all files, omit the <strong>id</strong> request parameter.\n\nExample CURL command:\n```bash\n curl -X GET https://api.lilt.com/v2/files?key=API_KEY&id=274\n```",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<integer>",
                  "description": "A unique File identifier."
                },
                {
                  "disabled": false,
                  "key": "labels",
                  "value": "<string>,<string>",
                  "description": "One or more labels. This will return the files which contain all of\nthe given labels.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
