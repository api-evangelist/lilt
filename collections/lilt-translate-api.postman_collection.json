        {
          "id": "54bf6ec4-9be7-43ac-905e-c6540aa98f3b",
          "name": "Translate a File",
          "request": {
            "name": "Translate a File",
            "description": {
              "content": "Start machine translation of one or more Files that have previously been uploaded.  The response will include an `id` parameter that can be used to monitor and download the translations in subsequent calls.\n\nExample CURL:\n```bash\ncurl -X POST 'https://api.lilt.com/v2/translate/file?key=API_KEY&fileId=583&memoryId=2495&configId=123&withTM=true'\n```\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "translate",
                "file"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fileId",
                  "value": "<integer>",
                  "description": "(Required) List of File ids to be translated, comma separated."
                },
