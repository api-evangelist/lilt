        {
          "id": "c3e51954-cd29-4260-8dca-3895d42d6d64",
          "name": "Translate a segment",
          "request": {
            "name": "Translate a segment",
            "description": {
              "content": "Translate a source string.\n\nFunctionally identical to `POST /v2/translate`, with parameters passed\nas query string parameters instead of a JSON request body. Useful for\nsimple integrations that prefer a GET request.\n\nSetting the `rich` parameter to `true` will change the response format\nto include additional information about each translation including a\nmodel score, word alignments,  and formatting information.\n\nBy default, this endpoint also returns translation memory (TM) fuzzy matches, along\nwith associated scores. Fuzzy matches always appear ahead of machine translation\noutput in the response.\n\nThe maximum source length is 5,000 characters.\n\nUsage charges apply to this endpoint for production API keys.\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "translate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "The source string to translate."
                },
                {
                  "disabled": false,
                  "key": "memory_id",
                  "value": "<integer>",
                  "description": "(Required) A unique Memory identifier."
                },
                {
                  "disabled": false,
                  "key": "source_hash",
                  "value": "<integer>",
                  "description": "A source hash code."
                },
                {
                  "disabled": false,
                  "key": "n",
                  "value": "<integer>",
                  "description": "Return top n translations (deprecated)."
                },
                {
                  "disabled": false,
                  "key": "prefix",
                  "value": "<string>",
                  "description": "A target prefix."
                },
                {
                  "disabled": false,
                  "key": "rich",
                  "value": "false",
                  "description": "Returns rich translation information (e.g., with word alignments)."
                },
                {
                  "disabled": false,
                  "key": "tm_matches",
                  "value": "true",
                  "description": "Include translation memory fuzzy matches."
                },
                {
                  "disabled": false,
                  "key": "project_tags",
                  "value": "false",
                  "description": "Project tags. Projects tags in source to target if set to true."
                },
                {
                  "disabled": false,
                  "key": "contains_icu_data",
                  "value": "false",
                  "description": "Contains ICU data. If true then tags in the source following the ICU standard will be parsed and retained."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
